# Copy to .env and fill in values

# Google Gemini
GOOGLE_API_KEY=
GENERATION_MODEL=gemini-2.5-flash
ROUTING_MODEL=gemini-2.5-flash

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# MLflow monitoring (tokens, latency, retrieval/rerank scores, confidence)
# Local default = a SQLite file in the project root: no server, no Docker.
#   View it:  .venv\Scripts\python.exe -m mlflow ui --backend-store-uri sqlite:///mlflow.db --port 5000
# For the Docker stack, point this at the MLflow server instead (http://mlflow:5000).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=rag-system
MLFLOW_ENABLED=true

# Embeddings
# EMBEDDING_PROVIDER: "gemini" (Gemini API, no local model/GPU) or "local" (SentenceTransformer on CPU)
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIM=768

# Optional: silences the HF Hub "unauthenticated requests" warning (used by the reranker)
HF_TOKEN=

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=6
RETRIEVER_TOP_K=20

# Cache
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600

# Web UI (FastHTML) sessions
# Set a real secret in production. SESSION_BACKEND: "memory" (local) or "redis" (multi-worker).
SESSION_SECRET=dev-insecure-change-me
SESSION_BACKEND=memory
