# Copy to .env and fill in values

# LLM: Qwen 3.8 27B (query analysis + answers)
# LLM_PROVIDER: "groq" (free tier, key from https://console.groq.com/keys)
#               or "hf" (Hugging Face Inference Providers; needs paid credits)
LLM_PROVIDER=groq
GROQ_API_KEY=
HF_TOKEN=
# Leave empty for the provider's default Qwen id (groq: qwen/qwen3.8-27b, hf: Qwen/Qwen3.8-27B)
LLM_MODEL=
# Only for LLM_PROVIDER=hf: "auto", or pin one of cerebras, deepinfra, novita, featherless-ai
HF_PROVIDER=auto
# Kept small for Groq's free tier (~8K tokens/min)
MAX_ANSWER_TOKENS=1024
MAX_CONTEXT_CHARS=16000

# Google Gemini: image descriptions (and embeddings if EMBEDDING_PROVIDER=gemini)
GOOGLE_API_KEY=
VISION_MODEL=gemini-2.5-flash

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# MLflow monitoring (tokens, latency, retrieval/rerank scores, confidence)
# Local default = a SQLite file in the project root: no server, no Docker.
#   View it:  .venv\Scripts\python.exe -m mlflow ui --backend-store-uri sqlite:///mlflow.db --port 5000
# For the Docker stack, point this at the MLflow server instead (http://mlflow:5000).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=rag-system
MLFLOW_ENABLED=true

# Embeddings
# EMBEDDING_PROVIDER: "openrouter" (qwen/qwen3-embedding-8b, ~$0.01 per million
# tokens; key from https://openrouter.ai/keys), "gemini" (free tier: 100 req/min),
# or "local" (all-mpnet-base-v2 on CPU; pip install -r requirements-local.txt)
EMBEDDING_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# Parallel embedding requests during ingest
EMBED_CONCURRENCY=4
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIM=768

# Retrieval: hits per sub-query, and how many fused chunks go into the prompt
RETRIEVER_TOP_K=20
CONTEXT_TOP_N=6

# Cache
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600

# Web UI (FastHTML) sessions
# Set a real secret in production. SESSION_BACKEND: "memory" (local) or "redis" (multi-worker).
SESSION_SECRET=dev-insecure-change-me
SESSION_BACKEND=memory

# Public-demo guard: caps on questions (0 = no cap)
MAX_QUESTIONS_PER_SESSION=20
DAILY_QUESTION_LIMIT=80
